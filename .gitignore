# Composer dependencies.
/vendor/

# Drupal core and contributed code are installed by Composer.
/web/core/
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/
/web/libraries/
/drush/Commands/contrib/

# Generated site files and local site configuration.
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/sites/*/aws-credentials.ini
/web/sites/*/credentials
/.aws/
/storage/

# Local environment files and secrets.
.env
.env.*
!.env.example

# Local database dumps and SQLite databases.
*.sql
*.sql.gz
*.dump
*.dump.gz
*.sqlite
*.sqlite3

# Local tooling, operating-system files, and test output.
/.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
*.swp
/.phpunit.cache/
/.phpstan-cache/
/coverage/
