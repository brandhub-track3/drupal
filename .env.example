# Drupal database name
MYSQL_DATABASE=brandhub_drupal

# Drupal ke liye dedicated MySQL user
MYSQL_USER=drupal_user

# Actual password .env me hoga
MYSQL_PASSWORD=change-me

# MySQL root/admin password
MYSQL_ROOT_PASSWORD=change-me

# Drupal security/hash salt
DRUPAL_HASH_SALT=change-me

# Compose image reference; production deploy sets IMAGE_TAG to the Git SHA.
DRUPAL_IMAGE=ghcr.io/brandhub-track3/drupal
IMAGE_TAG=latest

# Drupal connects to the MySQL service over the private Compose network.
DRUPAL_DB_HOST=mysql
DRUPAL_DB_PORT=3306